{
  "name": "fuckpdf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "pnpm --filter e2e test",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.10",
    "wrangler": "^4.68.1"
  }
}
